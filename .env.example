# Copy to .env.local for development. Never commit real values.
# Both values are public by design (they ship in the browser bundle);
# security comes from Row Level Security, not from hiding them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key in any VITE_ variable.
